datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
}

model User {
  id                  String         @id @default(uuid())
  name                String
  email               String         @unique
  password            String?
  googleId            String?        @unique
  authProvider        String         @default("local") // "local" | "google"
  role                String         @default("player") // "player" | "turf_owner"
  avatar              String         @default("")
  city                String         @default("Bangalore")
  preferredSports     String[]       @default(["Football", "Badminton"])
  skillLevel          String         @default("Intermediate")
  playingRole         String         @default("Midfielder")
  preferredPositions  String[]       @default(["Midfielder", "Forward"])
  preferredLocations  String[]       @default([])
  availability        Json?
  phone               String         @default("")
  bio                 String         @default("")
  rating              Float          @default(4.9)
  ratingsCount        Int            @default(1)
  matchesPlayed       Int            @default(0)
  stats               Json?
  createdAt           DateTime       @default(now())
  updatedAt           DateTime       @updatedAt

  turfProfiles        TurfProfile[]
  hostedMatches       Match[]        @relation("HostMatches")
  bookings            Booking[]      @relation("UserBookings")
  ownedBookings       Booking[]      @relation("OwnerBookings")
  chatMessages        ChatMessage[]
  notifications       Notification[] @relation("UserNotifications")
  sentNotifications   Notification[] @relation("SentNotifications")
  reviewsGiven        Review[]       @relation("ReviewsGiven")
  reviewsReceived     Review[]       @relation("ReviewsReceived")

  @@index([email])
  @@index([googleId])
  @@index([role])
  @@index([city])
}

model TurfProfile {
  id                  String    @id @default(uuid())
  ownerId             String
  owner               User      @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  businessName        String
  contactDetails      Json?
  city                String
  address             String
  coordinates         Json?     // { lat: Float, lng: Float }
  verificationStatus  String    @default("pending") // "pending" | "verified" | "rejected"
  tagline             String    @default("Modern Sports Venue")
  category            String    @default("Multi-sport Turf")
  sports              String[]  @default(["Football"])
  hourlyRate          Float     @default(1500)
  images              String[]  @default([])
  amenities           String[]  @default(["High-Power Floodlights", "Free Parking", "Changing Rooms & Showers"])
  description         String    @default("")
  openingHour         String    @default("06:00")
  closingHour         String    @default("23:00")
  slotDurationMinutes Int       @default(90)
  slots               Json?     // array of slots
  blockedSlots        Json?     // array of blocked slots
  rating              Float     @default(4.9)
  reviewsCount        Int       @default(0)
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  matches             Match[]
  bookings            Booking[]
  reviews             Review[]

  @@index([ownerId])
  @@index([city])
  @@index([verificationStatus])
}

model Match {
  id               String       @id @default(uuid())
  title            String
  sport            String
  description      String       @default("")
  coverImage       String       @default("")
  date             String
  time             String
  duration         String       @default("1.5 hrs")
  city             String
  location         String
  venue            String       @default("Community Ground")
  venueId          String?
  turf             TurfProfile? @relation(fields: [venueId], references: [id], onDelete: SetNull)
  hostId           String
  host             User         @relation("HostMatches", fields: [hostId], references: [id], onDelete: Cascade)
  hostName         String
  hostAvatar       String       @default("")
  maxPlayers       Int          @default(10)
  skillLevel       String       @default("All Levels")
  visibility       String       @default("public")
  isPublic         Boolean      @default(true)
  requiresApproval Boolean      @default(false)
  estimatedCost    Float        @default(0)
  feePerPlayer     Float        @default(0)
  status           String       @default("Open") // "Open" | "Spots Available" | "Full" | "In Progress" | "Completed" | "Cancelled"
  rules            String[]     @default(["Arrive 10 minutes prior to match time", "Wear appropriate sports footwear", "Respect referee and fellow players"])
  participants     Json?        // array of participant objects
  joinRequests     Json?        // array of join requests
  waitlist         Json?        // array of waitlisted players
  invitedPlayers   Json?        // array of invited player references
  teams            Json?        // { teamA: { name, score, players }, teamB: { name, score, players } }
  result           Json?        // { winner, teamAScore, teamBScore, mvp, notes, completedAt }
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt

  chatMessages     ChatMessage[]
  reviews          Review[]

  @@index([sport])
  @@index([city])
  @@index([date])
  @@index([status])
  @@index([hostId])
}

model Booking {
  id                 String      @id @default(uuid())
  turfId             String
  turf               TurfProfile @relation(fields: [turfId], references: [id], onDelete: Cascade)
  turfName           String
  turfCity           String      @default("Bangalore")
  turfLocation       String      @default("")
  ownerId            String
  owner              User        @relation("OwnerBookings", fields: [ownerId], references: [id], onDelete: Cascade)
  userId             String
  user               User        @relation("UserBookings", fields: [userId], references: [id], onDelete: Cascade)
  userName           String
  userEmail          String
  userPhone          String      @default("")
  date               String
  timeSlot           String
  slotId             String
  sport              String      @default("Football")
  court              String      @default("Main Court / Turf")
  amount             Float
  status             String      @default("Confirmed") // "Pending" | "Confirmed" | "Rejected" | "Cancelled" | "Completed"
  paymentStatus      String      @default("Paid") // "Pending" | "Paid" | "Refunded" | "Reserved" | "Failed"
  paymentMode        String      @default("demo") // "online" | "manual" | "demo"
  paymentId          String      @default("")
  bookingRef         String      @unique
  cancellationReason String      @default("")
  cancelledAt        DateTime?
  rescheduledFrom    Json?
  expiresAt          DateTime?
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  reviews            Review[]

  @@index([turfId, date, slotId, status])
  @@index([userId])
  @@index([ownerId])
  @@index([date])
}

model ChatMessage {
  id           String   @id @default(uuid())
  matchId      String
  match        Match    @relation(fields: [matchId], references: [id], onDelete: Cascade)
  senderId     String
  sender       User     @relation(fields: [senderId], references: [id], onDelete: Cascade)
  senderName   String
  senderAvatar String   @default("")
  text         String
  createdAt    DateTime @default(now())

  @@index([matchId])
  @@index([senderId])
}

model Notification {
  id           String   @id @default(uuid())
  recipientId  String
  recipient    User     @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  senderId     String?
  sender       User?    @relation("SentNotifications", fields: [senderId], references: [id], onDelete: SetNull)
  senderName   String   @default("")
  type         String   @default("general")
  title        String
  message      String
  actionLink   String   @default("")
  data         Json?
  read         Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@index([recipientId])
  @@index([read])
}

model Review {
  id             String       @id @default(uuid())
  type           String       // "turf" | "player"
  turfId         String?
  turf           TurfProfile? @relation(fields: [turfId], references: [id], onDelete: Cascade)
  targetUserId   String?
  targetUser     User?        @relation("ReviewsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)
  reviewerId     String
  reviewer       User         @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)
  reviewerName   String
  reviewerAvatar String       @default("")
  matchId        String?
  match          Match?       @relation(fields: [matchId], references: [id], onDelete: SetNull)
  bookingId      String?
  booking        Booking?     @relation(fields: [bookingId], references: [id], onDelete: SetNull)
  rating         Float
  comment        String       @default("")
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  @@index([type])
  @@index([turfId])
  @@index([targetUserId])
  @@index([reviewerId])
}

