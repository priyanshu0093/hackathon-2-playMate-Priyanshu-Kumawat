# PlayMate Shared Backend Environment Configuration (Example)
# Copy this file to .env and customize for local environment

PORT=5001
NODE_ENV=development

# PostgreSQL Database Connection URL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/playmate

# JSON Web Token Secret for Server-Verified Auth
JWT_SECRET=your_jwt_secret_change_in_production

# CORS Allowed Origins (comma separated)
CORS_ORIGIN=http://localhost:5174,http://localhost:5173,http://localhost:3000

# Realtime Server-Sent Events (SSE) Heartbeat Interval in ms
SSE_HEARTBEAT_INTERVAL=25000

# Payment Demo Sandbox Mode (Real payment gateway disabled in this milestone)
PAYMENT_GATEWAY_MODE=sandbox_demo

# Cancellation and Refund Policy
CANCELLATION_POLICY_MODE=demo_sandbox_pending
CANCELLATION_MIN_NOTICE_HOURS=2

# Default active city fallback
DEFAULT_CITY=Bangalore
